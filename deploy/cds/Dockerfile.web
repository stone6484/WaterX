FROM node:22-bookworm-slim AS build
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY apps ./apps
COPY deploy/cds/verify-static.mjs ./deploy/cds/verify-static.mjs
RUN pnpm install --frozen-lockfile --config.strict-builds=false
ARG GIT_COMMIT
RUN test ${#GIT_COMMIT} -eq 40 \
    && pnpm typecheck \
    && pnpm --filter @safety/admin-web build \
    && pnpm --filter @safety/mobile-h5 exec vite build --base /h5/ \
    && node deploy/cds/verify-static.mjs apps/admin-web/dist / "${GIT_COMMIT}" \
    && node deploy/cds/verify-static.mjs apps/mobile-h5/dist /h5/ "${GIT_COMMIT}"

FROM nginx:stable-alpine AS admin-web
ARG GIT_COMMIT
LABEL org.opencontainers.image.source="https://github.com/stone6484/WaterX" \
      org.opencontainers.image.revision="${GIT_COMMIT}"
COPY deploy/cds/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/admin-web/dist /usr/share/nginx/html
RUN find /usr/share/nginx/html -type d -exec chmod 755 {} + \
    && find /usr/share/nginx/html -type f -exec chmod 644 {} +
EXPOSE 8080

FROM nginx:stable-alpine AS mobile-h5
ARG GIT_COMMIT
LABEL org.opencontainers.image.source="https://github.com/stone6484/WaterX" \
      org.opencontainers.image.revision="${GIT_COMMIT}"
COPY deploy/cds/nginx-mobile.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/mobile-h5/dist /usr/share/nginx/html/h5
RUN find /usr/share/nginx/html -type d -exec chmod 755 {} + \
    && find /usr/share/nginx/html -type f -exec chmod 644 {} +
EXPOSE 8080
